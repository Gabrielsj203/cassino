// controllers/userController.js
const users = require("../models/userModel");
const bcrypt = require("bcrypt");
const { LIMITE_SAQUE } = require("../config/constants");

exports.login = (req, res) => {
  const { username, password } = req.body;
  const user = users.find(u => u.username === username);
  if (user && bcrypt.compareSync(password, user.password)) {
    res.json({ success: true, saldo: user.saldo });
  } else {
    res.status(401).json({ success: false, message: "Credenciais inválidas" });
  }
};

exports.sacar = (req, res) => {
  const { username, valor } = req.body;
  const user = users.find(u => u.username === username);
  if (user && user.saldo >= valor) {
    if (valor > LIMITE_SAQUE) {
      return res.status(400).json({ success: false, message: `O valor máximo de saque é ${LIMITE_SAQUE}` });
    }
    user.saldo -= valor;
    res.json({ success: true, saldo: user.saldo, message: "Saque realizado com sucesso" });
  } else {
    res.status(400).json({ success: false, message: "Saldo insuficiente ou usuário não encontrado" });
  }
};

// controllers/betController.js
const users = require("../models/userModel");
const bets = require("../models/betModel");
const affiliates = require("../models/affiliateModel");
const rng = require("../utils/random")("fixed-seed");
const { RTP_FIXO } = require("../config/constants");

function calcularPremio(aposta) {
  const chanceGanho = RTP_FIXO / 100;
  const ganhou = rng() < chanceGanho;
  return { ganhou, premio: ganhou ? aposta * (1 / chanceGanho) : 0 };
}

exports.apostar = (req, res) => {
  const { username, valor, jogo, ref } = req.body;
  const user = users.find(u => u.username === username);
  if (user && user.saldo >= valor) {
    user.saldo -= valor;
    const resultado = calcularPremio(valor);
    if (resultado.ganhou) user.saldo += resultado.premio;
    bets.push({ username, valor, jogo, resultado, data: new Date().toISOString() });
    if (ref) {
      const divulgador = affiliates.find(d => d.codigo === ref);
      if (divulgador) {
        divulgador.apostas += 1;
        divulgador.comissao += valor * 0.05;
      }
    }
    res.json({ success: true, saldo: user.saldo, resultado });
  } else {
    res.status(400).json({ success: false, message: "Saldo insuficiente" });
  }
};

